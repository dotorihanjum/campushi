# npm start가 이 파일의 복사본 frontend/.env.local을 서버에 전달합니다.
# .env.local은 커밋하지 않습니다. VITE_가 없는 값은 서버에서만 사용합니다.
VITE_SUPABASE_URL=https://lphfmgkpszzmvmqplwxd.supabase.co
SUPABASE_SECRET_KEY=
# 별도의 무작위 비밀값(32바이트 이상 권장). 없으면 서버 키에서 서명키를 파생합니다.
AUTH_COOKIE_SECRET=
# 운영/프리뷰에서는 각 배포의 정확한 HTTPS 주소. 로컬에서는 비워 둡니다.
AUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple Developer에서 발급한 유효한 client secret JWT. 만료 시 교체합니다.
APPLE_CLIENT_SECRET=
# 이메일 링크 로그인. STARTTLS 가능한 SMTP 서버가 필요합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# 아래 임시 URL은 나중에 정식 문서와 버전으로 함께 교체합니다.
AUTH_TERMS_URL=https://example.com/terms
AUTH_PRIVACY_URL=https://example.com/privacy
AUTH_TERMS_VERSION=development-placeholder-v1
